# Copia este archivo como `.env` y ajusta los valores. `.env` NO se commitea.

# development | test | production (en production se desactiva /docs)
ENVIRONMENT=development

# PostgreSQL local por socket Unix (autenticación "peer", sin contraseña).
# En Railway será una URL con usuario y contraseña; nunca la escribas aquí.
DATABASE_URL=postgresql+psycopg://renzzo@/fernwick?host=/var/run/postgresql

# Base de pruebas: pytest la vacía y la recrea con las migraciones.
# Su nombre DEBE terminar en _test (las pruebas se niegan a correr si no).
TEST_DATABASE_URL=postgresql+psycopg://renzzo@/fernwick_test?host=/var/run/postgresql

# Orígenes que pueden llamar a la API desde el navegador (CORS), separados por comas.
# Desarrollo: la landing local (:8000) y el panel con Vite (:5173). Nunca "*".
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
