# Copia este archivo como `.env` y ajusta los valores. `.env` NO se commitea.

# development | test | production (en production se desactiva /docs)
ENVIRONMENT=development

# PostgreSQL local por socket Unix (autenticación "peer", sin contraseña).
# En Railway será una URL con usuario y contraseña; nunca la escribas aquí.
DATABASE_URL=postgresql+psycopg://renzzo@/fernwick?host=/var/run/postgresql

# Rol dueño de las tablas, solo para Alembic y seed-demo (en Railway: el usuario postgres).
# Opcional: si falta se usa DATABASE_URL. En local no hace falta (renzzo es el dueño).
# MIGRATIONS_DATABASE_URL=

# Base de pruebas: pytest la vacía y la recrea con las migraciones.
# Su nombre DEBE terminar en _test (las pruebas se niegan a correr si no).
TEST_DATABASE_URL=postgresql+psycopg://renzzo@/fernwick_test?host=/var/run/postgresql

# Orígenes que pueden llamar a la API desde el navegador (CORS), separados por comas.
# Desarrollo: la landing local (:8080) y el panel con Vite (:5173). Nunca "*".
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Zona horaria del negocio (define qué día es "hoy" para el formulario y las métricas)
BUSINESS_TIMEZONE=America/New_York

# De dónde sale la IP del visitante para el límite de solicitudes:
#   none             -> IP de la conexión; ignora X-Forwarded-For y CF-Connecting-IP (desarrollo)
#   x-forwarded-for  -> entrada derecha de X-Forwarded-For (solo detrás de un proxy que la agregue)
#   cf-connecting-ip -> encabezado de Cloudflare (producción: Cloudflare -> Railway)
# Solo cambia "none" si TODAS las solicitudes pasan por ese proxy: si no, cualquiera puede inventar su IP.
CLIENT_IP_HEADER=none

# Clave para firmar los JWT (obligatoria, mínimo 32 bytes). Genera la tuya con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vacía aquí a propósito: la API no arranca hasta que pongas una. Nunca la commitees.
JWT_SECRET=

# Duración de los tokens de acceso, en minutos (1 a 1440)
JWT_EXPIRE_MINUTES=60

# Activa POST /v1/auth/demo (la cuenta demo de solo lectura). Por defecto: false.
DEMO_ENABLED=true
